{
  "expo": {
    "name": "StreamRealm",
    "slug": "streamrealm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/identity/icon.png",
    "scheme": "streamrealm",
    "userInterfaceStyle": "dark",
    "ios": {},
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E2A33",
        "foregroundImage": "./assets/images/identity/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/identity/favicon.png",
      "name": "StreamRealm",
      "shortName": "StreamRealm",
      "themeColor": "#0E2A33",
      "backgroundColor": "#081C23",
      "description": "Conquer your city stream. Help scientists protect it."
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E2A33",
          "image": "./assets/images/identity/splash.png",
          "resizeMode": "cover",
          "imageWidth": 400,
          "enableFullScreenImage_legacy": true
        }
      ],
      "expo-audio",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "StreamRealm uses your location to find the stream tile next to you."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "StreamRealm uses the camera to take stream check photos."
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#081C23"
  }
}
