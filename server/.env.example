# Copy the lines you need into your shell environment before starting the server.
# Everything is optional. Without ANTHROPIC_API_KEY the photo check uses local heuristics.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
AI_TIMEOUT_S=8
STREAMREALM_SEED_DEMO=1
CORS_ORIGINS=*
STREAMREALM_SEED_CITY=coimbra
